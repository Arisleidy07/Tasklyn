rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─────────────────────────────────────────────────────────────────────
    // IMPORTANT — why these helpers look defensive:
    //
    // In Storage rules, `firestore.get(path)` returns null when the document
    // does not exist, and reading `.data` on null (or reading a map key that
    // is not present) raises an evaluation ERROR. An error inside `!x` or
    // `a && x` propagates and the whole request is DENIED with
    // `storage/unauthorized` (HTTP 403) — even for owners and members.
    //
    // Legacy teams often have no `teams/{id}/members/{uid}` document and
    // many tasks have no `teamId` field, so every lookup below is guarded
    // with `firestore.exists()` and `map.get(key, default)`.
    //
    // NOTE: cross-service rules (firestore.get / firestore.exists) require
    // the Storage service agent to hold the "Firebase Rules Firestore
    // Service Agent" role. `firebase deploy --only storage` grants it.
    // ─────────────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function getAuthUid() {
      return request.auth.uid;
    }

    function fsPath(collectionName, docId) {
      return /databases/(default)/documents/$(collectionName)/$(docId);
    }

    // Data of a Firestore document, or an empty map when it does not exist.
    function docData(collectionName, docId) {
      return firestore.exists(fsPath(collectionName, docId))
        ? firestore.get(fsPath(collectionName, docId)).data
        : {};
    }

    function teamData(teamId) {
      return docData('teams', teamId);
    }

    // Role stored in teams/{teamId}/members/{uid}, or '' when absent.
    function teamMemberRole(teamId) {
      let p = /databases/(default)/documents/teams/$(teamId)/members/$(getAuthUid());
      return firestore.exists(p) ? firestore.get(p).data.get('role', '') : '';
    }

    function isTeamMember(teamId) {
      let t = teamData(teamId);
      return teamId is string && (
        t.get('owner', '') == getAuthUid() ||
        getAuthUid() in t.get('memberIds', []) ||
        teamMemberRole(teamId) != ''
      );
    }

    function isTeamAdminOrOwner(teamId) {
      let role = teamMemberRole(teamId);
      return teamId is string && (
        teamData(teamId).get('owner', '') == getAuthUid() ||
        role == 'owner' || role == 'admin'
      );
    }

    // "viewer" (Solo lectura). The team owner is never a viewer.
    function isTeamViewer(teamId) {
      return teamId is string &&
        teamData(teamId).get('owner', '') != getAuthUid() &&
        teamMemberRole(teamId) == 'viewer';
    }

    function listData(listId) {
      return docData('lists', listId);
    }

    function isListOwner(listId) {
      return listData(listId).get('owner', '') == getAuthUid();
    }

    function isListMember(listId) {
      let l = listData(listId);
      return l.get('owner', '') == getAuthUid() ||
        getAuthUid() in l.get('memberIds', []);
    }

    // Member of the team that owns the list (covers team members who are not
    // explicitly in list.memberIds).
    function isListTeamMember(listId) {
      let teamId = listData(listId).get('teamId', null);
      return teamId is string && isTeamMember(teamId);
    }

    function isListViewerScoped(listId) {
      let teamId = listData(listId).get('teamId', null);
      return teamId is string && isTeamViewer(teamId);
    }

    // Profile photos — owner can read/write, others can read
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth() && getAuthUid() == userId;
      allow delete: if isAuth() && getAuthUid() == userId;
    }

    // Team photos — team members can read, team admin/owner can write/delete
    match /teams/{teamId}/{allPaths=**} {
      allow read: if isAuth() && isTeamMember(teamId);
      allow write: if isAuth() && isTeamAdminOrOwner(teamId);
      allow delete: if isAuth() && isTeamAdminOrOwner(teamId);
    }

    // Background images library — any authenticated user can read.
    // Only the uploader (matched by folder userId) can write/delete.
    match /backgrounds/{userId}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth() && getAuthUid() == userId;
      allow delete: if isAuth() && getAuthUid() == userId;
    }

    // List-specific images: list members read, list owner writes.
    match /lists/{listId}/{allPaths=**} {
      allow read: if isAuth() && isListMember(listId);
      allow write: if isAuth() && isListOwner(listId);
      allow delete: if isAuth() && isListOwner(listId);
    }

    // Task attachments — the task document must exist first (the app creates
    // it before uploading). Access: task creator, list owner/members, members
    // of the task's team or of the list's team. Viewers can only read.
    match /tasks/{taskId}/attachments/{attachmentId} {
      function task() {
        return docData('tasks', taskId);
      }
      function taskListId() {
        return task().get('listId', null);
      }
      function taskTeamId() {
        return task().get('teamId', null);
      }
      function canAccessTaskFiles() {
        let t = task();
        return t.size() > 0 && (
          t.get('createdBy', '') == getAuthUid() ||
          (taskListId() is string && isListMember(taskListId())) ||
          (taskTeamId() is string && isTeamMember(taskTeamId())) ||
          (taskListId() is string && isListTeamMember(taskListId()))
        );
      }
      function isViewerScopedTask() {
        return (taskTeamId() is string && isTeamViewer(taskTeamId())) ||
          (taskListId() is string && isListViewerScoped(taskListId()));
      }
      allow read: if isAuth() && canAccessTaskFiles();
      allow create, update: if isAuth() && canAccessTaskFiles() &&
        !isViewerScopedTask() &&
        request.resource.size < 200 * 1024 * 1024;
      allow delete: if isAuth() && canAccessTaskFiles() && !isViewerScopedTask();
    }

    // Technician report evidence — the report document must exist first.
    // Read: creator or any member of the report's team.
    // Write: only the report creator. Delete: creator or team admin/owner.
    match /reports/{reportId}/{allPaths=**} {
      function report() {
        return docData('reports', reportId);
      }
      function reportTeamId() {
        return report().get('teamId', null);
      }
      function isReportCreator() {
        return report().get('createdBy', '') == getAuthUid();
      }
      allow read: if isAuth() && (
        isReportCreator() ||
        (reportTeamId() is string && isTeamMember(reportTeamId()))
      );
      allow create, update: if isAuth() && isReportCreator() &&
        request.resource.size < 1024 * 1024 * 1024;
      allow delete: if isAuth() && (
        isReportCreator() ||
        (reportTeamId() is string && isTeamAdminOrOwner(reportTeamId()))
      );
    }

    // Form files — header images and response uploads
    match /forms/{formId}/{allPaths=**} {
      function form() {
        return docData('forms', formId);
      }
      function formTeamId() {
        return form().get('teamId', null);
      }
      function isFormOwner() {
        return form().get('createdBy', '') == getAuthUid();
      }
      allow read: if isAuth() && (
        isFormOwner() ||
        (formTeamId() is string && isTeamMember(formTeamId()))
      );
      // Form owner uploads header images; team members (not viewers) upload
      // response files.
      allow create, update: if isAuth() &&
        request.resource.size < 200 * 1024 * 1024 && (
        isFormOwner() ||
        (formTeamId() is string && isTeamMember(formTeamId()) &&
         !isTeamViewer(formTeamId()))
      );
      allow delete: if isAuth() && (
        isFormOwner() ||
        (formTeamId() is string && isTeamAdminOrOwner(formTeamId()))
      );
    }

    // Legacy image paths (old uploads before the organized structure).
    // Keep read access so existing profile/team/background photos keep loading.
    match /profile-photos/{userId}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth() && getAuthUid() == userId;
      allow delete: if isAuth() && getAuthUid() == userId;
    }

    match /team-photos/{teamId}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth() && isTeamAdminOrOwner(teamId);
      allow delete: if isAuth() && isTeamAdminOrOwner(teamId);
    }

    match /background-images/{userId}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth() && getAuthUid() == userId;
      allow delete: if isAuth() && getAuthUid() == userId;
    }

    // Fallback: deny everything else. Storage rules are OR-ed across every
    // matching block, so a permissive catch-all here would let ANY signed-in
    // user read private task, report and form files. Every path the app uses
    // is matched explicitly above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
