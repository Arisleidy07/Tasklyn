rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function getAuthUid() {
      return request.auth.uid;
    }

    // Helper to check if a user is a member of the list
    function isListMember() {
      return resource.data.memberIds != null && getAuthUid() in resource.data.memberIds;
    }

    // Helper to check if user will be a member after update
    function willBeListMember() {
      return request.resource.data.memberIds != null && getAuthUid() in request.resource.data.memberIds;
    }

    // Helper to check if user is a team member (uses get() for non-team rule contexts)
    function isTeamMember(teamId) {
      let team = get(/databases/$(database)/documents/teams/$(teamId)).data;
      return team != null && team.memberIds != null && getAuthUid() in team.memberIds;
    }

    // Helper to check if user is team owner (uses get() for non-team rule contexts)
    function isTeamOwner(teamId) {
      let team = get(/databases/$(database)/documents/teams/$(teamId)).data;
      return team != null && team.owner == getAuthUid();
    }

    // Helper to check if user is team admin/owner — uses resource.data (no get() call)
    // members is stored as an array so we use the owner field directly
    function isTeamAdminDirect() {
      return resource.data.owner == getAuthUid();
    }

    // Helper to check if user will be team owner after create
    function willBeTeamOwner() {
      return request.resource.data.owner == getAuthUid();
    }

    // Helper to check if a user is joining a team via invitation (adding themselves only)
    function isJoiningTeam() {
      return isAuth() &&
        resource.data.memberIds != null &&
        !(getAuthUid() in resource.data.memberIds) &&
        request.resource.data.memberIds != null &&
        getAuthUid() in request.resource.data.memberIds;
    }

    // Helper to check if user is the owner
    function isListOwner() {
      return resource.data.owner != null && resource.data.owner == getAuthUid();
    }

    // Helper to check if user will be owner after create
    function willBeListOwner() {
      return request.resource.data.owner != null && request.resource.data.owner == getAuthUid();
    }

    // Check if user is joining a list via invitation acceptance
    // Safe because user can only add themselves to memberIds
    function isJoiningList() {
      return isAuth() &&
        !isListMember() &&
        request.resource.data.memberIds != null &&
        (getAuthUid() in request.resource.data.memberIds);
    }

    // Check if user has a valid invitation to this list
    // This allows reading the list when accepting an invitation
    function hasValidInvitationToList(listId) {
      // Check if there's an invitation for this user to this list
      // Since we can't query in rules, we allow read for authenticated users
      // and rely on the invitation token validation in the client code
      return isAuth();
    }

    match /users/{userId} {
      // Allow reading public profile fields for any authenticated user
      // This is needed for displaying names in activity feed, ranking, notifications, etc.
      allow read: if isAuth();
      allow create, update: if isAuth() && getAuthUid() == userId;
      allow delete: if false;
    }

    match /lists/{listId} {
      // Allow read if user is a member or owner
      allow read: if isAuth() && (
        isListMember() ||
        isListOwner() ||
        willBeListMember()
      );

      // Allow create if user will be owner or member
      allow create: if isAuth() && (
        willBeListOwner() ||
        (request.resource.data.memberIds != null && getAuthUid() in request.resource.data.memberIds)
      );

      // Allow update if user is a member, owner, or joining via invitation
      allow update: if isAuth() && (
        isListMember() ||
        isListOwner() ||
        isJoiningList()
      );

      allow delete: if isAuth() && isListOwner();
    }

    match /tasks/{taskId} {
      allow read, create, update, delete: if isAuth();
    }

    match /invitations/{invitationId} {
      allow read: if true;
      allow create: if isAuth();
      // Allow delete/update by any authenticated user
      // Invitation validation happens client-side via token lookup
      allow update, delete: if isAuth();
    }

    match /teams/{teamId} {
      // Allow read if user is in memberIds (uses resource.data directly — no circular get)
      allow read: if isAuth() && (
        resource.data.memberIds != null && getAuthUid() in resource.data.memberIds
      );

      // Allow create if user will be owner
      allow create: if isAuth() && willBeTeamOwner();

      // Allow update if user is the owner, OR user is joining via invitation acceptance
      allow update: if isAuth() && (isTeamAdminDirect() || isJoiningTeam());

      // Allow delete if user is team owner
      allow delete: if isAuth() && resource.data.owner == getAuthUid();
    }

    match /goals/{goalId} {
      allow read, create, update, delete: if isAuth();
    }

    match /achievements/{achievementId} {
      allow read, create, update, delete: if isAuth();
    }

    // Subscriptions - only user can read their own, server can write
    match /subscriptions/{subscriptionId} {
      allow read: if isAuth() && (
        resource.data.userId == getAuthUid() ||
        request.resource.data.userId == getAuthUid()
      );
      allow create, update: if isAuth() && (
        resource.data.userId == getAuthUid() ||
        request.resource.data.userId == getAuthUid()
      );
      allow delete: if false;
    }

    // Payments - read-only for users, server writes via API
    match /payments/{paymentId} {
      allow read: if isAuth() && (
        resource.data.userId == getAuthUid() ||
        request.resource.data.userId == getAuthUid()
      );
      allow create, update, delete: if false; // Only server-side via Admin SDK
    }

    // Notifications - users can read/update/delete their own, system can create
    match /notifications/{notificationId} {
      allow read: if isAuth() && (
        resource.data.userId == getAuthUid() ||
        request.resource.data.userId == getAuthUid()
      );
      allow create: if isAuth(); // Allow any authenticated user to create notifications
      allow update: if isAuth() && (
        resource.data.userId == getAuthUid() ||
        request.resource.data.userId == getAuthUid()
      );
      allow delete: if isAuth() && resource.data.userId == getAuthUid();
    }

    // Comments - readable by list members
    match /comments/{commentId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.authorId == getAuthUid();
      allow update: if isAuth() && resource.data.authorId == getAuthUid();
      allow delete: if isAuth() && resource.data.authorId == getAuthUid();
    }

    // Clients - owner and team members can access
    match /clients/{clientId} {
      allow read: if isAuth() && (
        resource.data.ownerId == getAuthUid() ||
        (resource.data.teamId != null && isTeamMember(resource.data.teamId))
      );
      allow create: if isAuth() && request.resource.data.ownerId == getAuthUid();
      allow update: if isAuth() && resource.data.ownerId == getAuthUid();
      allow delete: if isAuth() && resource.data.ownerId == getAuthUid();
    }

  }
}
