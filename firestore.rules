rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ──────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // ── Team helpers ──────────────────────────────────────────────────────────

    // Used on the team document itself (no extra get() needed)
    function isTeamOwnerDirect() {
      return resource.data.owner != null && resource.data.owner == uid();
    }

    function isTeamMemberDirect() {
      return resource.data.memberIds != null && uid() in resource.data.memberIds;
    }

    function willBeTeamOwner() {
      return request.resource.data.owner != null && request.resource.data.owner == uid();
    }

    // Cross-collection lookup — used only in subcollections
    function isTeamOwnerOf(teamId) {
      let t = get(/databases/$(database)/documents/teams/$(teamId)).data;
      return t != null && t.owner != null && t.owner == uid();
    }

    function isTeamMemberOf(teamId) {
      let t = get(/databases/$(database)/documents/teams/$(teamId)).data;
      return t != null && t.memberIds != null && uid() in t.memberIds;
    }

    function isTeamAdminOrOwnerOf(teamId) {
      let m = get(/databases/$(database)/documents/teams/$(teamId)/members/$(uid())).data;
      return m != null && (m.role == "owner" || m.role == "admin");
    }

    // ── List helpers ──────────────────────────────────────────────────────────

    function isListOwner() {
      return resource.data.owner != null && resource.data.owner == uid();
    }

    function isListMember() {
      return resource.data.memberIds != null && uid() in resource.data.memberIds;
    }

    // Cross-collection lookup for task permissions (task stores its listId)
    function isListMemberOf(listId) {
      let l = get(/databases/$(database)/documents/lists/$(listId)).data;
      return l != null && l.memberIds != null && uid() in l.memberIds;
    }

    function isListOwnerOf(listId) {
      let l = get(/databases/$(database)/documents/lists/$(listId)).data;
      return l != null && l.owner == uid();
    }

    function acceptedInvitation(invitationId, targetType, targetId) {
      let invitation = getAfter(/databases/$(database)/documents/invitations/$(invitationId)).data;
      return invitation != null &&
        invitation.type == targetType &&
        invitation.targetId == targetId &&
        invitation.status == "accepted" &&
        invitation.acceptedBy == uid();
    }

    function isAcceptingListInvitation(listId) {
      return isAuth() &&
        !isListMember() &&
        request.resource.data.memberIds != null &&
        uid() in request.resource.data.memberIds &&
        request.resource.data.memberIds.toSet().hasAll(resource.data.memberIds.toSet()) &&
        request.resource.data.memberIds.toSet().size() == resource.data.memberIds.toSet().size() + 1 &&
        request.resource.data.lastProcessedInvitationId is string &&
        acceptedInvitation(request.resource.data.lastProcessedInvitationId, "list", listId);
    }

    function isAcceptingTeamInvitation(teamId) {
      let invitation = getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.lastProcessedInvitationId)).data;
      return isAuth() &&
        !isTeamMemberDirect() &&
        request.resource.data.memberIds != null &&
        uid() in request.resource.data.memberIds &&
        request.resource.data.members.size() == resource.data.members.size() + 1 &&
        request.resource.data.lastProcessedInvitationId is string &&
        invitation != null &&
        ((invitation.type == "team" && invitation.targetId == teamId) ||
          (invitation.type == "list" && invitation.teamId == teamId)) &&
        invitation.status == "accepted" &&
        invitation.acceptedBy == uid();
    }

    // ── Collections ───────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && uid() == userId &&
        request.resource.data.plan == "free";
      allow update: if isAuth() && uid() == userId &&
        request.resource.data.plan == resource.data.plan &&
        request.resource.data.subscriptionStatus == resource.data.subscriptionStatus;
      allow delete: if false;
    }

    match /lists/{listId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (
        isListOwner() ||
        isListMember() ||
        isAcceptingListInvitation(listId) ||
        (resource.data.teamId != null && isTeamAdminOrOwnerOf(resource.data.teamId))
      );
      allow delete: if isAuth() && (
        isListOwner() ||
        (resource.data.teamId != null && isTeamAdminOrOwnerOf(resource.data.teamId))
      );
    }

    match /tasks/{taskId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.createdBy == uid() ||
        resource.data.assignedTo == uid() ||
        (resource.data.listId != null && isListMemberOf(resource.data.listId)) ||
        (resource.data.teamId != null && isTeamAdminOrOwnerOf(resource.data.teamId))
      );
      // Hard delete only allowed as part of team/list cascade deletion by owner
      allow delete: if isAuth() && (
        resource.data.createdBy == uid() ||
        (resource.data.teamId != null && isTeamOwnerOf(resource.data.teamId))
      );

      // Task history subcollection
      match /history/{entryId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update, delete: if false;
      }

      // Task comments subcollection
      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth() && request.resource.data.userId == uid();
        allow update: if isAuth() && resource.data.userId == uid();
        allow delete: if isAuth() && resource.data.userId == uid();
      }
    }

    match /invitations/{invitationId} {
      // Public read needed for link-based invitations (no account required)
      allow read: if true;
      allow create: if isAuth() &&
        request.resource.data.invitedBy == uid() &&
        request.resource.data.status == "pending";
      allow update: if isAuth() &&
        resource.data.status == "pending" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "acceptedAt", "acceptedBy", "declinedAt", "declinedBy"
        ]) && (
          (request.resource.data.status == "accepted" && request.resource.data.acceptedBy == uid()) ||
          (request.resource.data.status == "declined" && request.resource.data.declinedBy == uid())
        );
      allow delete: if isAuth() && (
        resource.data.invitedBy == uid() ||
        (resource.data.listId != null && isListOwnerOf(resource.data.listId)) ||
        (resource.data.teamId != null && isTeamOwnerOf(resource.data.teamId))
      );
    }

    match /teams/{teamId} {
      // Read: owner OR member. Also allow if doc is corrupt/legacy (uid in memberIds OR owner match)
      allow read: if isAuth() && (
        resource.data.owner == uid() ||
        (resource.data.memberIds != null && uid() in resource.data.memberIds) ||
        isTeamAdminOrOwnerOf(teamId)
      );
      allow create: if isAuth() && willBeTeamOwner();
      allow update: if isAuth() && (
        isTeamOwnerDirect() ||
        isTeamAdminOrOwnerOf(teamId) ||
        isAcceptingTeamInvitation(teamId)
      );
      // Owner can delete. Also allow delete if doc owner field matches uid (covers legacy docs)
      allow delete: if isAuth() && (
        resource.data.owner == uid() ||
        isTeamOwnerDirect()
      );

      // Members subcollection
      match /members/{memberId} {
        allow read: if isAuth() && (
          isTeamMemberOf(teamId) ||
          isTeamOwnerOf(teamId)
        );

        allow create: if isAuth() && (
          isTeamAdminOrOwnerOf(teamId) ||
          isTeamOwnerOf(teamId) ||
          (uid() == memberId &&
            request.resource.data.userId == uid() &&
            request.resource.data.invitationId is string &&
            getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.status == "accepted" &&
            getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.acceptedBy == uid() &&
            uid() in getAfter(/databases/$(database)/documents/teams/$(teamId)).data.memberIds)
        );

        allow update: if isAuth() && (
          isTeamOwnerOf(teamId) ||
          isTeamAdminOrOwnerOf(teamId)
        );

        // Owner can delete anyone. Admin can remove members. Member can leave. 
        allow delete: if isAuth() && (
          isTeamOwnerOf(teamId) ||
          isTeamAdminOrOwnerOf(teamId) ||
          uid() == memberId
        );
      }

      // Activity subcollection — immutable log
      match /activity/{entryId} {
        allow read: if isAuth() && isTeamMemberOf(teamId);
        allow create: if isAuth() &&
          isTeamMemberOf(teamId) &&
          request.resource.data.userId == uid();
        allow update: if false;
        allow delete: if isAuth() && isTeamOwnerOf(teamId);
      }

      // Scores subcollection
      match /scores/{userId} {
        allow read: if isAuth() && isTeamMemberOf(teamId);
        allow create, update: if isAuth() && (
          uid() == userId ||
          isTeamOwnerOf(teamId)
        );
        allow delete: if isAuth() && isTeamOwnerOf(teamId);
      }
    }

    match /goals/{goalId} {
      allow read: if isAuth();
      allow create: if isAuth() && (
        request.resource.data.createdBy == uid() ||
        (request.resource.data.teamId != null && isTeamAdminOrOwnerOf(request.resource.data.teamId))
      );
      allow update: if isAuth() && (
        resource.data.createdBy == uid() ||
        (resource.data.teamId != null && isTeamAdminOrOwnerOf(resource.data.teamId))
      );
      allow delete: if isAuth() && (
        resource.data.createdBy == uid() ||
        (resource.data.teamId != null && isTeamOwnerOf(resource.data.teamId))
      );
    }

    match /achievements/{achievementId} {
      allow read: if isAuth();
      allow create: if isAuth() && (
        request.resource.data.userId == uid() ||
        (request.resource.data.teamId != null && isTeamAdminOrOwnerOf(request.resource.data.teamId))
      );
      allow update, delete: if isAuth() && (
        resource.data.userId == uid() ||
        (resource.data.teamId != null && isTeamOwnerOf(resource.data.teamId))
      );
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAuth() && resource.data.userId == uid();
      allow create, update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAuth() && (
        resource.data.userId == uid() ||
        request.resource.data.userId == uid()
      );
      allow create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAuth() && (
        resource.data.userId == uid() ||
        (resource.data.teamId != null && isTeamOwnerOf(resource.data.teamId))
      );
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.userId == uid();
      allow delete: if isAuth() && (
        resource.data.userId == uid() ||
        (resource.data.teamId != null && isTeamOwnerOf(resource.data.teamId))
      );
    }

    // Legacy root comments collection (new comments go to tasks/{taskId}/comments)
    match /comments/{commentId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.authorId == uid();
      allow update: if isAuth() && resource.data.authorId == uid();
      allow delete: if isAuth() && (
        resource.data.authorId == uid() ||
        (resource.data.listId != null && isListOwnerOf(resource.data.listId))
      );
    }

    // Background images library
    match /backgroundImages/{imageId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.uploadedBy == uid();
      // Allow any auth user to update (reorder, move category) — only uploader can delete
      allow update: if isAuth();
      allow delete: if isAuth() && resource.data.uploadedBy == uid();
    }

    match /bgCategories/{categoryId} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth();
    }

    // Shared backgrounds library (Ítem 9)
    match /backgrounds/{bgId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.uploadedBy == uid();
      allow update: if isAuth() && resource.data.uploadedBy == uid();
      allow delete: if isAuth() && resource.data.uploadedBy == uid();
    }

    match /clients/{clientId} {
      allow read: if isAuth() && (
        resource.data.ownerId == uid() ||
        (resource.data.teamId != null && isTeamMemberOf(resource.data.teamId))
      );
      allow create: if isAuth() && request.resource.data.ownerId == uid();
      allow update: if isAuth() && resource.data.ownerId == uid();
      allow delete: if isAuth() && resource.data.ownerId == uid();
    }

  }
}
