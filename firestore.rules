rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ──────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // ── Team helpers ──────────────────────────────────────────────────────────

    // Used on the team document itself (no extra get() needed)
    function isTeamOwnerDirect() {
      return resource.data.owner != null && resource.data.owner == uid();
    }

    function isTeamMemberDirect() {
      return resource.data.memberIds != null && uid() in resource.data.memberIds;
    }

    function willBeTeamOwner() {
      return request.resource.data.owner != null && request.resource.data.owner == uid();
    }

    // Cross-collection lookup — used only in subcollections
    function isTeamOwnerOf(teamId) {
      let t = get(/databases/$(database)/documents/teams/$(teamId)).data;
      return t != null && t.owner != null && t.owner == uid();
    }

    function isTeamMemberOf(teamId) {
      let t = get(/databases/$(database)/documents/teams/$(teamId)).data;
      return t != null && t.memberIds != null && uid() in t.memberIds;
    }

    function isTeamAdminOrOwnerOf(teamId) {
      let m = get(/databases/$(database)/documents/teams/$(teamId)/members/$(uid())).data;
      return m != null && (m.role == "owner" || m.role == "admin");
    }

    // Role of the current user in a team's members subcollection (null if absent)
    function teamMemberRoleOf(teamId) {
      return teamId != null &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(uid()))
        ? get(/databases/$(database)/documents/teams/$(teamId)/members/$(uid())).data.role
        : null;
    }

    // Safe field accessors: reading a missing map key throws in rules,
    // so optional fields must be read through `in` checks first.
    function docTeamId(data) {
      return data != null && 'teamId' in data ? data.teamId : null;
    }

    function docListId(data) {
      return data != null && 'listId' in data ? data.listId : null;
    }

    // "viewer" (Solo lectura) members must not modify team-scoped data
    function isTeamViewerOf(teamId) {
      return teamId != null && teamMemberRoleOf(teamId) == "viewer";
    }

    function isViewerInList(listId) {
      return listId != null &&
        exists(/databases/$(database)/documents/lists/$(listId)) &&
        isTeamViewerOf(docTeamId(get(/databases/$(database)/documents/lists/$(listId)).data));
    }

    // True when the task belongs to a team (directly or via its list) where
    // the current user has the read-only "viewer" role
    function isViewerScopedTask(taskId) {
      return exists(/databases/$(database)/documents/tasks/$(taskId)) && (
        isTeamViewerOf(docTeamId(get(/databases/$(database)/documents/tasks/$(taskId)).data)) ||
        isViewerInList(docListId(get(/databases/$(database)/documents/tasks/$(taskId)).data))
      );
    }

    // ── List helpers ──────────────────────────────────────────────────────────

    function isListOwner() {
      return resource.data.owner != null && resource.data.owner == uid();
    }

    function isListMember() {
      return resource.data.memberIds != null && uid() in resource.data.memberIds;
    }

    // Cross-collection lookup for task permissions (task stores its listId)
    function isListMemberOf(listId) {
      let l = get(/databases/$(database)/documents/lists/$(listId)).data;
      return l != null && l.memberIds != null && uid() in l.memberIds;
    }

    // Safe (never-erroring) membership checks used for task attachments.
    function safeDoc(path) {
      return exists(path) ? get(path).data : {};
    }

    function safeIsTeamMember(teamId) {
      let t = safeDoc(/databases/$(database)/documents/teams/$(teamId));
      return teamId is string && (
        t.get('owner', '') == uid() ||
        uid() in t.get('memberIds', []) ||
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(uid()))
      );
    }

    function safeIsListMemberOrTeam(listId) {
      let l = safeDoc(/databases/$(database)/documents/lists/$(listId));
      return listId is string && (
        l.get('owner', '') == uid() ||
        uid() in l.get('memberIds', []) ||
        (l.get('teamId', null) is string && safeIsTeamMember(l.get('teamId', null)))
      );
    }

    function canAccessTaskFiles(taskId) {
      let t = safeDoc(/databases/$(database)/documents/tasks/$(taskId));
      return t.size() > 0 && (
        t.get('createdBy', '') == uid() ||
        safeIsListMemberOrTeam(t.get('listId', null)) ||
        safeIsTeamMember(t.get('teamId', null))
      );
    }

    function isListOwnerOf(listId) {
      let l = get(/databases/$(database)/documents/lists/$(listId)).data;
      return l != null && l.owner == uid();
    }

    function acceptedInvitation(invitationId, targetType, targetId) {
      let invitation = getAfter(/databases/$(database)/documents/invitations/$(invitationId)).data;
      return invitation != null &&
        invitation.type == targetType &&
        invitation.targetId == targetId &&
        invitation.status == "accepted" &&
        invitation.acceptedBy == uid();
    }

    function isAcceptingListInvitation(listId) {
      return isAuth() &&
        !isListMember() &&
        request.resource.data.memberIds != null &&
        uid() in request.resource.data.memberIds &&
        request.resource.data.memberIds.toSet().hasAll(resource.data.memberIds.toSet()) &&
        request.resource.data.memberIds.toSet().size() == resource.data.memberIds.toSet().size() + 1 &&
        request.resource.data.lastProcessedInvitationId is string &&
        acceptedInvitation(request.resource.data.lastProcessedInvitationId, "list", listId);
    }

    function isAcceptingTeamInvitation(teamId) {
      let invitation = getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.lastProcessedInvitationId)).data;
      return isAuth() &&
        !isTeamMemberDirect() &&
        request.resource.data.memberIds != null &&
        uid() in request.resource.data.memberIds &&
        request.resource.data.members.size() == resource.data.members.size() + 1 &&
        request.resource.data.lastProcessedInvitationId is string &&
        invitation != null &&
        ((invitation.type == "team" && invitation.targetId == teamId) ||
          (invitation.type == "list" && invitation.teamId == teamId)) &&
        invitation.status == "accepted" &&
        invitation.acceptedBy == uid();
    }

    // ── Collections ───────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && uid() == userId &&
        request.resource.data.plan == "free";
      allow update: if isAuth() && uid() == userId &&
        request.resource.data.plan == resource.data.plan &&
        request.resource.data.subscriptionStatus == resource.data.subscriptionStatus;
      allow delete: if false;
    }

    match /lists/{listId} {
      allow read: if isAuth();
      allow create: if isAuth() &&
        !isTeamViewerOf(docTeamId(request.resource.data));
      allow update: if isAuth() && !isTeamViewerOf(docTeamId(resource.data)) && (
        isListOwner() ||
        isListMember() ||
        isAcceptingListInvitation(listId) ||
        (resource.data.teamId != null && isTeamAdminOrOwnerOf(resource.data.teamId))
      );
      allow delete: if isAuth() && !isTeamViewerOf(docTeamId(resource.data)) && (
        isListOwner() ||
        (resource.data.teamId != null && isTeamAdminOrOwnerOf(resource.data.teamId))
      );
    }

    match /tasks/{taskId} {
      allow read: if isAuth();
      allow create: if isAuth() &&
        !isTeamViewerOf(docTeamId(request.resource.data)) &&
        !isViewerInList(docListId(request.resource.data));
      allow update: if isAuth() &&
        !isTeamViewerOf(docTeamId(resource.data)) &&
        !isViewerInList(docListId(resource.data)) && (
        resource.data.createdBy == uid() ||
        resource.data.assignedTo == uid() ||
        (resource.data.listId != null && isListMemberOf(resource.data.listId)) ||
        (resource.data.teamId != null && isTeamAdminOrOwnerOf(resource.data.teamId)) ||
        // Anyone allowed to attach files may refresh ONLY the attachment
        // summary shown on task cards.
        (request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['attachmentCount', 'attachmentPreviews']) &&
         canAccessTaskFiles(taskId))
      );
      // Delete allowed for the creator, any member of the task's list (editors),
      // and the team owner (cascade/admin cleanup)
      allow delete: if isAuth() &&
        !isTeamViewerOf(docTeamId(resource.data)) &&
        !isViewerInList(docListId(resource.data)) && (
        resource.data.createdBy == uid() ||
        resource.data.assignedTo == uid() ||
        (resource.data.listId != null && isListMemberOf(resource.data.listId)) ||
        (resource.data.teamId != null && isTeamOwnerOf(resource.data.teamId))
      );

      // Task history subcollection
      match /history/{entryId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update, delete: if false;
      }

      // Task comments subcollection
      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth() &&
          request.resource.data.userId == uid() &&
          !isViewerScopedTask(taskId);
        allow update: if isAuth() &&
          resource.data.userId == uid() &&
          !isViewerScopedTask(taskId);
        allow delete: if isAuth() &&
          resource.data.userId == uid() &&
          !isViewerScopedTask(taskId);
      }

      // Task attachments subcollection. Metadata holds tokenized download
      // URLs (which bypass Storage rules), so reads are limited to people
      // who can actually access the task's list or team.
      match /attachments/{attachmentId} {
        allow read: if isAuth() && canAccessTaskFiles(taskId);
        allow create: if isAuth() &&
          request.resource.data.uploadedBy == uid() &&
          canAccessTaskFiles(taskId) &&
          !isViewerScopedTask(taskId);
        // The uploader completes their own metadata after the Storage
        // upload ("uploading" -> "complete"); ownership can't change.
        allow update: if isAuth() &&
          resource.data.uploadedBy == uid() &&
          request.resource.data.uploadedBy == uid() &&
          !isViewerScopedTask(taskId);
        allow delete: if isAuth() &&
          resource.data.uploadedBy == uid() &&
          !isViewerScopedTask(taskId);
      }
    }

    match /invitations/{invitationId} {
      // Public read needed for link-based invitations (no account required)
      allow read: if true;
      allow create: if isAuth() &&
        request.resource.data.invitedBy == uid() &&
        request.resource.data.status == "pending";
      allow update: if isAuth() &&
        resource.data.status == "pending" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "acceptedAt", "acceptedBy", "declinedAt", "declinedBy"
        ]) && (
          (request.resource.data.status == "accepted" && request.resource.data.acceptedBy == uid()) ||
          (request.resource.data.status == "declined" && request.resource.data.declinedBy == uid())
        );
      allow delete: if isAuth() && (
        resource.data.invitedBy == uid() ||
        (resource.data.listId != null && isListOwnerOf(resource.data.listId)) ||
        (resource.data.teamId != null && isTeamOwnerOf(resource.data.teamId))
      );
    }

    match /teams/{teamId} {
      // Read: owner OR member. Also allow if doc is corrupt/legacy (uid in memberIds OR owner match)
      allow read: if isAuth() && (
        resource.data.owner == uid() ||
        (resource.data.memberIds != null && uid() in resource.data.memberIds) ||
        isTeamAdminOrOwnerOf(teamId)
      );
      allow create: if isAuth() && willBeTeamOwner();
      allow update: if isAuth() && (
        isTeamOwnerDirect() ||
        isTeamAdminOrOwnerOf(teamId) ||
        isAcceptingTeamInvitation(teamId)
      );
      // Owner can delete. Also allow delete if doc owner field matches uid (covers legacy docs)
      allow delete: if isAuth() && (
        resource.data.owner == uid() ||
        isTeamOwnerDirect()
      );

      // Members subcollection
      match /members/{memberId} {
        allow read: if isAuth() && (
          isTeamMemberOf(teamId) ||
          isTeamOwnerOf(teamId)
        );

        allow create: if isAuth() &&
          (request.resource.data.role != "owner" || isTeamOwnerOf(teamId)) && (
          isTeamAdminOrOwnerOf(teamId) ||
          isTeamOwnerOf(teamId) ||
          (uid() == memberId &&
            request.resource.data.userId == uid() &&
            request.resource.data.invitationId is string &&
            getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.status == "accepted" &&
            getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.acceptedBy == uid() &&
            uid() in getAfter(/databases/$(database)/documents/teams/$(teamId)).data.memberIds)
        );

        allow update: if isAuth() && (
          isTeamOwnerOf(teamId) ||
          (isTeamAdminOrOwnerOf(teamId) &&
           request.resource.data.role != "owner")
        );

        // Owner can delete anyone. Admin can remove members. Member can leave.
        allow delete: if isAuth() && (
          isTeamOwnerOf(teamId) ||
          isTeamAdminOrOwnerOf(teamId) ||
          uid() == memberId
        );
      }

      // Activity subcollection — immutable log
      match /activity/{entryId} {
        allow read: if isAuth() && isTeamMemberOf(teamId);
        allow create: if isAuth() &&
          isTeamMemberOf(teamId) &&
          teamMemberRoleOf(teamId) != "viewer" &&
          request.resource.data.userId == uid();
        allow update: if false;
        allow delete: if isAuth() && isTeamOwnerOf(teamId);
      }

      // Scores subcollection
      match /scores/{userId} {
        allow read: if isAuth() && isTeamMemberOf(teamId);
        allow create, update: if isAuth() &&
          teamMemberRoleOf(teamId) != "viewer" && (
          uid() == userId ||
          isTeamOwnerOf(teamId)
        );
        allow delete: if isAuth() && isTeamOwnerOf(teamId);
      }
    }

    match /goals/{goalId} {
      allow read: if isAuth();
      allow create: if isAuth() &&
        !isTeamViewerOf(docTeamId(request.resource.data)) && (
        request.resource.data.createdBy == uid() ||
        (request.resource.data.teamId != null && isTeamAdminOrOwnerOf(request.resource.data.teamId))
      );
      allow update: if isAuth() &&
        !isTeamViewerOf(docTeamId(resource.data)) && (
        resource.data.createdBy == uid() ||
        (resource.data.teamId != null && isTeamAdminOrOwnerOf(resource.data.teamId))
      );
      allow delete: if isAuth() &&
        !isTeamViewerOf(docTeamId(resource.data)) && (
        resource.data.createdBy == uid() ||
        (resource.data.teamId != null && isTeamOwnerOf(resource.data.teamId))
      );
    }

    match /achievements/{achievementId} {
      allow read: if isAuth();
      allow create: if isAuth() &&
        !isTeamViewerOf(docTeamId(request.resource.data)) && (
        request.resource.data.userId == uid() ||
        (request.resource.data.teamId != null && isTeamAdminOrOwnerOf(request.resource.data.teamId))
      );
      allow update, delete: if isAuth() &&
        !isTeamViewerOf(docTeamId(resource.data)) && (
        resource.data.userId == uid() ||
        (resource.data.teamId != null && isTeamOwnerOf(resource.data.teamId))
      );
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAuth() && resource.data.userId == uid();
      allow create, update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAuth() && resource.data.userId == uid();
      allow create, update, delete: if false;
    }

    match /invoices/{invoiceId} {
      allow read: if isAuth() && resource.data.userId == uid();
      allow create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAuth() && (
        resource.data.userId == uid() ||
        (resource.data.teamId != null && isTeamOwnerOf(resource.data.teamId))
      );
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.userId == uid();
      allow delete: if isAuth() && (
        resource.data.userId == uid() ||
        (resource.data.teamId != null && isTeamOwnerOf(resource.data.teamId))
      );
    }

    // Legacy root comments collection (new comments go to tasks/{taskId}/comments)
    match /comments/{commentId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.authorId == uid();
      allow update: if isAuth() && resource.data.authorId == uid();
      allow delete: if isAuth() && (
        resource.data.authorId == uid() ||
        (resource.data.listId != null && isListOwnerOf(resource.data.listId))
      );
    }

    // Background images library
    match /backgroundImages/{imageId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.uploadedBy == uid();
      // Allow any auth user to update (reorder, move category) — only uploader can delete
      allow update: if isAuth();
      allow delete: if isAuth() && resource.data.uploadedBy == uid();
    }

    match /bgCategories/{categoryId} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth();
    }

    // Shared backgrounds library (Ítem 9)
    match /backgrounds/{bgId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.uploadedBy == uid();
      allow update: if isAuth() && resource.data.uploadedBy == uid();
      allow delete: if isAuth() && resource.data.uploadedBy == uid();
    }

    match /clients/{clientId} {
      allow read: if isAuth() && (
        resource.data.ownerId == uid() ||
        (resource.data.teamId != null && isTeamMemberOf(resource.data.teamId))
      );
      allow create: if isAuth() &&
        request.resource.data.ownerId == uid() &&
        !isTeamViewerOf(docTeamId(request.resource.data));
      allow update: if isAuth() &&
        resource.data.ownerId == uid() &&
        !isTeamViewerOf(docTeamId(resource.data));
      allow delete: if isAuth() &&
        resource.data.ownerId == uid() &&
        !isTeamViewerOf(docTeamId(resource.data));
    }

    // Activity collection (root) - user activity log
    match /activity/{activityId} {
      allow read: if isAuth() && resource.data.userId == uid();
      allow create: if isAuth() && request.resource.data.userId == uid();
      allow update: if false;
      allow delete: if false;
    }

    // Technician Reports collection
    match /reports/{reportId} {
      // Read: creator + ANY member of the report's team (technicians must be
      // able to consult team reports, not only admins/owners)
      allow read: if isAuth() && (
        resource.data.createdBy == uid() ||
        (resource.data.teamId != null && isTeamMemberOf(resource.data.teamId))
      );

      // Create: authenticated user, own createdBy, declaration confirmed.
      // If a teamId is provided the user must belong to that team.
      allow create: if isAuth() &&
        request.resource.data.createdBy == uid() &&
        request.resource.data.createdByName is string &&
        request.resource.data.declarationConfirmed == true &&
        (docTeamId(request.resource.data) == null ||
         (isTeamMemberOf(docTeamId(request.resource.data)) &&
          teamMemberRoleOf(docTeamId(request.resource.data)) != "viewer"));

      // Update: only the report creator can update their own reports
      allow update: if isAuth() &&
        resource.data.createdBy == uid() &&
        request.resource.data.createdBy == resource.data.createdBy; // Prevent changing owner

      // Delete: only the report creator can delete their own reports
      // Team admins/owners can also delete for cleanup
      allow delete: if isAuth() && (
        resource.data.createdBy == uid() ||
        (resource.data.teamId != null && isTeamAdminOrOwnerOf(resource.data.teamId))
      );
    }

    // Forms collection (Google Forms-like)
    match /forms/{formId} {
      // Read: form owner, team members of the form's team
      allow read: if isAuth() && (
        resource.data.createdBy == uid() ||
        (resource.data.teamId != null && isTeamMemberOf(resource.data.teamId))
      );

      // Create: only authenticated users can create forms
      // Must belong to the team
      // Must use their own userId as createdBy (prevent impersonation)
      allow create: if isAuth() &&
        request.resource.data.teamId != null &&
        isTeamMemberOf(request.resource.data.teamId) &&
        teamMemberRoleOf(request.resource.data.teamId) != "viewer" &&
        request.resource.data.createdBy == uid() &&
        request.resource.data.createdByName is string;

      // Update: only the form owner can update
      allow update: if isAuth() &&
        resource.data.createdBy == uid() &&
        request.resource.data.createdBy == resource.data.createdBy; // Prevent changing owner

      // Delete: only the form owner can delete
      // Team owners can also delete for cleanup
      allow delete: if isAuth() && (
        resource.data.createdBy == uid() ||
        (resource.data.teamId != null && isTeamOwnerOf(resource.data.teamId))
      );

      // Participants subcollection
      match /participants/{userId} {
        // Read: form owner, team members, the participant themselves
        allow read: if isAuth() && (
          resource.data.createdBy == uid() ||
          get(/databases/$(database)/documents/forms/$(formId)).data.createdBy == uid() ||
          uid() == userId ||
          isTeamMemberOf(get(/databases/$(database)/documents/forms/$(formId)).data.teamId)
        );

        // Create: form owner can add participants
        allow create: if isAuth() &&
          get(/databases/$(database)/documents/forms/$(formId)).data.createdBy == uid() &&
          request.resource.data.userId is string;

        // Update: form owner can update participant roles
        allow update: if isAuth() &&
          get(/databases/$(database)/documents/forms/$(formId)).data.createdBy == uid();

        // Delete: form owner can remove participants
        allow delete: if isAuth() &&
          get(/databases/$(database)/documents/forms/$(formId)).data.createdBy == uid();
      }

      // Responses subcollection
      match /responses/{responseId} {
        // Read: form owner can read all responses
        // Participant can read their own responses
        allow read: if isAuth() && (
          resource.data.respondentId == uid() ||
          get(/databases/$(database)/documents/forms/$(formId)).data.createdBy == uid() ||
          (get(/databases/$(database)/documents/forms/$(formId)).data.teamId != null &&
           isTeamAdminOrOwnerOf(get(/databases/$(database)/documents/forms/$(formId)).data.teamId))
        );

        // Create: authenticated users can submit responses
        // Must use their own userId as respondentId (prevent impersonation)
        // Viewers (read-only) cannot submit responses to team forms
        allow create: if isAuth() &&
          request.resource.data.respondentId == uid() &&
          request.resource.data.respondentName is string &&
          request.resource.data.formId == formId &&
          !isTeamViewerOf(docTeamId(get(/databases/$(database)/documents/forms/$(formId)).data));

        // Update: respondent can update their own draft responses
        allow update: if isAuth() &&
          resource.data.respondentId == uid() &&
          resource.data.status == "draft";

        // Delete: form owner can delete responses
        allow delete: if isAuth() && (
          get(/databases/$(database)/documents/forms/$(formId)).data.createdBy == uid() ||
          (get(/databases/$(database)/documents/forms/$(formId)).data.teamId != null &&
           isTeamOwnerOf(get(/databases/$(database)/documents/forms/$(formId)).data.teamId))
        );
      }
    }

  }
}
