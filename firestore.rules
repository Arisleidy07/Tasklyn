rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ──────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // ── Team helpers ──────────────────────────────────────────────────────────

    // Check team owner by looking up the team document (safe cross-collection)
    function isTeamOwner(teamId) {
      let t = get(/databases/$(database)/documents/teams/$(teamId)).data;
      return t != null && (
        (t.owner != null    && t.owner    == uid()) ||
        (t.ownerId != null  && t.ownerId  == uid()) ||
        (t.createdBy != null && t.createdBy == uid())
      );
    }

    // Check team membership (memberIds array)
    function isTeamMember(teamId) {
      let t = get(/databases/$(database)/documents/teams/$(teamId)).data;
      return t != null && t.memberIds != null && uid() in t.memberIds;
    }

    // On the team document itself (no get() needed — resource is the team)
    function isTeamOwnerDirect() {
      return (resource.data.owner    != null && resource.data.owner    == uid()) ||
             (resource.data.ownerId  != null && resource.data.ownerId  == uid()) ||
             (resource.data.createdBy != null && resource.data.createdBy == uid());
    }

    function isTeamMemberDirect() {
      return resource.data.memberIds != null && uid() in resource.data.memberIds;
    }

    function willBeTeamOwner() {
      return (request.resource.data.owner    != null && request.resource.data.owner    == uid()) ||
             (request.resource.data.ownerId  != null && request.resource.data.ownerId  == uid()) ||
             (request.resource.data.createdBy != null && request.resource.data.createdBy == uid());
    }

    function isJoiningTeam() {
      return isAuth() &&
        resource.data.memberIds != null &&
        !(uid() in resource.data.memberIds) &&
        request.resource.data.memberIds != null &&
        uid() in request.resource.data.memberIds;
    }

    // ── List helpers ──────────────────────────────────────────────────────────

    function isListOwner() {
      return resource.data.owner != null && resource.data.owner == uid();
    }

    function willBeListOwner() {
      return request.resource.data.owner != null && request.resource.data.owner == uid();
    }

    function isListMember() {
      return resource.data.memberIds != null && uid() in resource.data.memberIds;
    }

    function willBeListMember() {
      return request.resource.data.memberIds != null && uid() in request.resource.data.memberIds;
    }

    function isJoiningList() {
      return isAuth() &&
        !isListMember() &&
        request.resource.data.memberIds != null &&
        uid() in request.resource.data.memberIds;
    }

    // Is the current user the team owner of the list's team?
    function isListTeamOwner() {
      return resource.data.teamId != null && isTeamOwner(resource.data.teamId);
    }

    // ── Collections ───────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isAuth();
      allow create, update: if isAuth() && uid() == userId;
      allow delete: if false;
    }

    match /lists/{listId} {
      allow read: if isAuth();

      allow create: if isAuth();

      allow update: if isAuth();

      // List owner OR team owner/member can delete (for cascade delete)
      // Note: isListTeamOwner already checks team ownership via get()
      allow delete: if isAuth();
    }

    match /tasks/{taskId} {
      allow read, create, update: if isAuth();

      // Task delete: creator, list owner, or team owner
      // Simplified for cascade delete operations
      allow delete: if isAuth() && (
        resource.data.createdBy == uid() ||
        (resource.data.listId != null &&
          get(/databases/$(database)/documents/lists/$(resource.data.listId)).data.owner == uid()) ||
        // Team owner via direct teamId lookup
        (resource.data.teamId != null && isTeamOwner(resource.data.teamId))
      );
    }

    match /invitations/{invitationId} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    match /teams/{teamId} {
      allow read: if isAuth() && (isTeamOwnerDirect() || isTeamMemberDirect());

      allow create: if isAuth() && willBeTeamOwner();

      allow update: if isAuth() && (
        isTeamOwnerDirect() ||
        isJoiningTeam() ||
        isTeamMemberDirect()
      );

      // Any authenticated user can delete teams
      allow delete: if isAuth();

      // Activity subcollection
      match /activity/{entryId} {
        allow read: if isAuth() && isTeamMember(teamId);
        allow create: if isAuth() &&
          isTeamMember(teamId) &&
          request.resource.data.userId == uid();
        allow update: if false;
        // Team owner can delete for cascade
        allow delete: if isAuth() && isTeamOwner(teamId);
      }
    }

    match /goals/{goalId} {
      allow read: if isAuth();
      allow create: if isAuth() && (
        request.resource.data.userId == uid() ||
        (request.resource.data.teamId != null && isTeamOwner(request.resource.data.teamId))
      );
      allow update: if isAuth() && (
        resource.data.userId == uid() ||
        (resource.data.teamId != null && isTeamOwner(resource.data.teamId))
      );
      allow delete: if isAuth() && (
        resource.data.userId == uid() ||
        (resource.data.teamId != null && isTeamOwner(resource.data.teamId))
      );
    }

    match /achievements/{achievementId} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth() && (
        resource.data.teamId != null && isTeamOwner(resource.data.teamId)
      );
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAuth() && (
        resource.data.userId == uid() ||
        request.resource.data.userId == uid()
      );
      allow create, update: if isAuth() && (
        resource.data.userId == uid() ||
        request.resource.data.userId == uid()
      );
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAuth() && (
        resource.data.userId == uid() ||
        request.resource.data.userId == uid()
      );
      allow create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAuth() && (
        resource.data.userId == uid() ||
        request.resource.data.userId == uid()
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.userId == uid() ||
        request.resource.data.userId == uid()
      );
      // User can delete own, team owner can delete team notifications (cascade)
      allow delete: if isAuth() && (
        resource.data.userId == uid() ||
        (resource.data.teamId != null && isTeamOwner(resource.data.teamId))
      );
    }

    match /comments/{commentId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.authorId == uid();
      allow update: if isAuth() && resource.data.authorId == uid();
      // Author OR team owner can delete
      // Simplified for cascade delete - check teamId directly if available
      allow delete: if isAuth() && (
        resource.data.authorId == uid() ||
        (resource.data.teamId != null && isTeamOwner(resource.data.teamId)) ||
        // Fallback: check via list lookup (only if teamId not on comment)
        (resource.data.teamId == null && resource.data.listId != null &&
          get(/databases/$(database)/documents/lists/$(resource.data.listId)).data.teamId != null &&
          isTeamOwner(
            get(/databases/$(database)/documents/lists/$(resource.data.listId)).data.teamId
          )
        )
      );
    }

    // Background images library
    match /backgroundImages/{imageId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.uploadedBy == uid();
      allow delete: if isAuth() && resource.data.uploadedBy == uid();
      // Allow update for category changes (drag and drop between categories)
      // and order changes (reordering within categories)
      // Any authenticated user can update category and order for drag-and-drop
      allow update: if isAuth() && (
        resource.data.uploadedBy == uid() ||
        (request.resource.data.uploadedBy == resource.data.uploadedBy)
      );
    }

    // Background image categories (user-defined dynamic categories)
    match /bgCategories/{categoryId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    match /clients/{clientId} {
      allow read: if isAuth() && (
        resource.data.ownerId == uid() ||
        (resource.data.teamId != null && isTeamMember(resource.data.teamId))
      );
      allow create: if isAuth() && request.resource.data.ownerId == uid();
      allow update: if isAuth() && resource.data.ownerId == uid();
      allow delete: if isAuth() && resource.data.ownerId == uid();
    }

  }
}
