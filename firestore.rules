rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // Helper Functions
    // ============================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    function isListMember(listId) {
      let list = get(/databases/$(database)/documents/lists/$(listId)).data;
      return request.auth.uid in list.memberIds;
    }
    
    function isListOwner(listId) {
      let list = get(/databases/$(database)/documents/lists/$(listId)).data;
      return list.owner == request.auth.uid;
    }
    
    function isListEditor(listId) {
      // Firestore rules cannot iterate maps inside arrays, so role enforcement
      // (owner vs editor vs viewer) is handled client-side. This rule ensures
      // only authenticated list members can write — viewers are blocked from
      // the UI before they can reach write paths.
      return isListOwner(listId) || isListMember(listId);
    }
    
    // ============================================
    // Users Collection
    // ============================================
    
    match /users/{userId} {
      // Allow read if authenticated
      allow read: if isAuthenticated();
      
      // Allow create if it's the authenticated user's own document
      allow create: if isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.plan in ['FREE', 'PRO'];
      
      // Allow update if it's the user's own document
      allow update: if isOwner(userId)
        && (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['id', 'createdAt']));
      
      // No delete allowed
      allow delete: if false;
    }
    
    // ============================================
    // Lists Collection
    // ============================================
    
    match /lists/{listId} {
      // Allow read if authenticated — needed for invitation acceptance flow
      // (accepting user is not yet a member at read time).
      // Tasks are still protected by member-check on the tasks collection.
      allow read: if isAuthenticated();
      
      // Allow create if authenticated (creator's UID must be in memberIds)
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.memberIds;
      
      // Allow update based on role
      allow update: if isAuthenticated()
        && (
          // Special case: User accepting invitation (adding themselves to the list)
          (request.auth.uid in request.resource.data.memberIds
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['members', 'memberIds', 'type'])
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['members', 'memberIds', 'type', 'updatedAt']))
          ||
          // Regular updates: User must already be a member
          (isListMember(listId)
            && (
              // Owners can update anything
              isListOwner(listId)
              ||
              // Editors can update name/description only
              (isListEditor(listId)
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['name', 'description', 'updatedAt']))
            ))
        );
      
      // Allow delete only by owner
      allow delete: if isAuthenticated()
        && isListOwner(listId);
    }
    
    // ============================================
    // Tasks Collection
    // ============================================
    
    match /tasks/{taskId} {
      // Allow read if user is a member of the list
      allow read: if isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/lists/$(resource.data.listId)).data.memberIds;
      
      // Allow create if user has edit permission
      allow create: if isAuthenticated()
        && isListEditor(request.resource.data.listId);
      
      // Allow update based on list role
      allow update: if isAuthenticated()
        && isListEditor(resource.data.listId);
      
      // Allow delete only by task creator or list owner
      allow delete: if isAuthenticated()
        && (
          resource.data.createdBy == request.auth.uid
          || isListOwner(resource.data.listId)
        );
    }
    
    // ============================================
    // Invitations Collection
    // ============================================
    
    match /invitations/{invitationId} {
      // Allow read by anyone (needed for invite acceptance)
      // In production, you might want to restrict this
      allow read: if true;
      
      // Allow create by list members with editor+ role
      allow create: if isAuthenticated()
        && isListEditor(request.resource.data.listId);
      
      // Allow update (for acceptance) by authenticated user
      allow update: if isAuthenticated();
      
      // Allow delete by any authenticated user — invitee cleans up after acceptance.
      // The invitation token (unguessable) is the security mechanism for access.
      allow delete: if isAuthenticated();
    }
    
    // ============================================
    // Notifications Collection
    // ============================================
    
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId != null;
    }
    
  }
}
