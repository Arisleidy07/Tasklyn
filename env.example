# ============================================
# TASKLYN — Firebase Configuration
# ============================================
# 1. Go to https://console.firebase.google.com
# 2. Create a project (or use an existing one)
# 3. Go to Project Settings > General > Your apps > Web app
# 4. Copy the config values below
# 5. Rename this file to .env.local
# ============================================

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ============================================
# TASKLYN — Email (Resend)
# ============================================
# 1. Go to https://resend.com and create an account
# 2. Create an API key in the dashboard
# 3. Add your domain and verify it
# ============================================

RESEND_API_KEY=re_your_api_key_here
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ============================================
# TASKLYN — PayPal Sandbox
# ============================================
# 1. Go to https://developer.paypal.com/developer/applications
# 2. Create a Sandbox app
# 3. Copy Client ID and Secret below
# ============================================

PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-secret
PAYPAL_ENVIRONMENT=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
NEXT_PUBLIC_PAYPAL_ENVIRONMENT=sandbox

# PayPal Subscription Plans (create with scripts/create-paypal-plans.js)
PAYPAL_PRODUCT_ID=PROD-...
PAYPAL_PRO_PLAN_ID=P-...
PAYPAL_BUSINESS_PLAN_ID=P-...

# ============================================
# TASKLYN — Firebase Admin SDK (backend only)
# ============================================
# 1. Go to Firebase Console > Project Settings > Service Accounts
# 2. Generate a new private key
# 3. Fill in the values below (do NOT commit this file)
# ============================================

FIREBASE_ADMIN_PROJECT_ID=tasklyn-51996
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-...-...@tasklyn-51996.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

