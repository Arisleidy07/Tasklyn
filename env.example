# ============================================
# TASKLYN — Firebase Configuration
# ============================================
# 1. Go to https://console.firebase.google.com
# 2. Create a project (or use an existing one)
# 3. Go to Project Settings > General > Your apps > Web app
# 4. Copy the config values below
# 5. Rename this file to .env.local
# ============================================

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ============================================
# TASKLYN — Email (Resend)
# ============================================
# 1. Go to https://resend.com and create an account
# 2. Create an API key in the dashboard
# 3. Add your domain and verify it
# ============================================

RESEND_API_KEY=re_your_api_key_here
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ============================================
# TASKLYN — PayPal Configuration
# ============================================
# Sandbox credentials for testing (DO NOT USE IN PRODUCTION)
# Get these from: https://developer.paypal.com/dashboard/
# ============================================

# PayPal Sandbox (Testing)
PAYPAL_SANDBOX_CLIENT_ID=your-sandbox-client-id
PAYPAL_SANDBOX_CLIENT_SECRET=your-sandbox-client-secret

# PayPal Live (Production) - ONLY ENABLE AFTER TESTING
PAYPAL_LIVE_CLIENT_ID=your-live-client-id
PAYPAL_LIVE_CLIENT_SECRET=your-live-client-secret

# PayPal Mode: sandbox | live
PAYPAL_MODE=sandbox

# PayPal Webhook Secret (for validating webhooks)
PAYPAL_WEBHOOK_SECRET=your-webhook-secret

# PayPal Plan IDs (Public - will be exposed to frontend)
# Create these in PayPal Developer Dashboard > Products & Plans
NEXT_PUBLIC_PAYPAL_PRO_PLAN_ID=your-pro-plan-id
NEXT_PUBLIC_PAYPAL_BUSINESS_PLAN_ID=your-business-plan-id

# ============================================
# INSTRUCCIONES PARA CONFIGURAR PAYPAL SANDBOX
# ============================================
# 1. Ve a https://developer.paypal.com/dashboard/
# 2. Crea una cuenta de desarrollador (si no tienes)
# 3. Crea una app en "My Apps & Credentials"
# 4. Copia el Client ID y Secret de Sandbox
# 5. Crea productos y planes en "Products & Plans"
#    - Plan PRO: $4.99 USD/mes
#    - Plan BUSINESS: $14.99 USD/mes
# 6. Copia los Plan IDs a las variables de arriba
# 7. Configura webhooks apuntando a: https://tu-dominio.com/api/paypal/webhook
# 8. Para pruebas locales, usa ngrok para exponer tu servidor local
